# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=development
APP_NAME="Auto Dealer API"
APP_PORT=3000
APP_GLOBAL_PREFIX=api
APP_URL=http://localhost:3000
# Base public URL used to build absolute links (uploads, etc.)
PUBLIC_URL=http://localhost:3000

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
# Used by docker-compose
POSTGRES_USER=autodealer
POSTGRES_PASSWORD=autodealer
POSTGRES_DB=autodealer
POSTGRES_PORT=5432
# Used by Prisma (must match the values above)
DATABASE_URL="postgresql://autodealer:autodealer@localhost:5432/autodealer?schema=public"

# ============================================================================
# REDIS (cache + pub/sub events)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Default TTL for cached vehicle specs (seconds)
CACHE_TTL=3600

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d
# Password reset token validity (minutes)
PASSWORD_RESET_EXPIRES_MIN=30

# Account lockout policy
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ============================================================================
# SECURITY
# ============================================================================
# Comma separated list of allowed origins (or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Rate limit: requests per TTL window
THROTTLE_TTL=60
THROTTLE_LIMIT=120
BCRYPT_SALT_ROUNDS=10

# ============================================================================
# FILE STORAGE
# ============================================================================
# Driver: "local" (dev) or "s3" (future / production)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Max upload size in bytes (10 MB)
UPLOAD_MAX_SIZE=10485760
# Comma separated allowed mime types
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# --- S3 (only used when STORAGE_DRIVER=s3) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ============================================================================
# MAIL (Nodemailer)
# ============================================================================
# Driver: "smtp" or "console" (logs emails instead of sending - good for dev)
MAIL_DRIVER=console
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME="Auto Dealer"
MAIL_FROM_ADDRESS=no-reply@autodealer.local

# ============================================================================
# BUSINESS / INTEGRATIONS
# ============================================================================
# Default country code for WhatsApp deep links (Brazil = 55)
WHATSAPP_COUNTRY_CODE=55
# Lead assignment strategy: "round_robin" or "least_busy"
LEAD_ASSIGNMENT_STRATEGY=round_robin
# Days before a document expires to start alerting
DOC_EXPIRY_ALERT_DAYS=30
# Default reservation duration in days
RESERVATION_DEFAULT_DAYS=3

# External vehicle specs provider (optional - mock used if empty)
VEHICLE_SPECS_PROVIDER=mock
VEHICLE_SPECS_API_URL=
VEHICLE_SPECS_API_KEY=
