// ============================================================================
// Auto Dealer Platform - Prisma Schema
// PostgreSQL + Prisma ORM. UUID primary keys. Monetary values use Decimal(14,2).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  SELLER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PersonType {
  INDIVIDUAL // pessoa física
  COMPANY // pessoa jurídica
}

enum VehicleStatus {
  DRAFT
  AWAITING_INSPECTION
  AWAITING_DOCUMENTS
  IN_MAINTENANCE
  AVAILABLE
  RESERVED
  NEGOTIATING
  SOLD
  DELIVERED
  CONSIGNED
  ARCHIVED
}

enum VehicleCondition {
  NEW
  SEMINEW
  USED
}

enum VehicleOrigin {
  OWN_PURCHASE // compra própria
  CONSIGNMENT // consignação
  TRADE_IN // troca
}

enum FuelType {
  GASOLINE
  ETHANOL
  FLEX
  DIESEL
  ELECTRIC
  HYBRID
  GNV
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
  AUTOMATED
  DUAL_CLUTCH
}

enum SpecSource {
  MANUAL
  PROVIDER_MOCK
  PROVIDER_EXTERNAL
  IMPORTED
}

enum StockMovementType {
  ENTRY
  EXIT
  RESERVE
  CANCEL_RESERVE
  SALE
  CONSIGNMENT
  TRADE_IN
  ARCHIVE
}

enum PartStatus {
  ACTIVE
  INACTIVE
}

enum PartMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  RESERVE
  CANCEL_RESERVE
  APPLY_TO_VEHICLE
  REVERSAL
  LOSS
  RETURN
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  AWAITING_PARTS
  COMPLETED
  CANCELED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  REVISION
  AESTHETIC // funilaria/pintura/polimento
  INSPECTION
  OTHER
}

enum DocumentOwnerType {
  VEHICLE
  BUYER
  SELLER
  CUSTOMER
}

enum DocumentStatus {
  NOT_REQUESTED
  PENDING_REQUEST
  AWAITING_BUYER_DOCUMENT
  AWAITING_SELLER_DOCUMENT
  AWAITING_VEHICLE_DOCUMENT
  RECEIVED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  NOT_APPLICABLE
}

enum ChecklistStage {
  PURCHASE
  STOCK_ENTRY
  AD_PREPARATION
  RESERVATION
  SALE
  TRANSFER
  DELIVERY
  AFTER_SALES
}

enum AcquisitionType {
  OWN_PURCHASE
  CONSIGNMENT
  TRADE_IN
}

enum AcquisitionStatus {
  DRAFT
  CONFIRMED
  CANCELED
}

enum ReservationStatus {
  ACTIVE
  CANCELED
  CONVERTED
  EXPIRED
}

enum SaleStatus {
  LEAD_CREATED
  CONTACT_STARTED
  NEGOTIATING
  AWAITING_CUSTOMER_DOCUMENTS
  AWAITING_PAYMENT
  AWAITING_TRANSFER
  READY_FOR_DELIVERY
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  FINANCING
  CHECK
  BANK_SLIP
  TRADE_IN
}

enum FinancialNature {
  REVENUE
  EXPENSE
}

enum FinancialOrigin {
  AUTOMATIC
  MANUAL
}

enum FinancialStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum CommissionRuleType {
  PERCENT_SALE // percentual sobre o valor da venda
  PERCENT_PROFIT // percentual sobre o lucro
  FIXED // valor fixo
  PROGRESSIVE // faixas progressivas
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELED
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  NEGOTIATING
  CONVERTED
  LOST
}

enum LeadOrigin {
  SPECIALIST_BUTTON
  WEBSITE_FORM
  PHONE
  WHATSAPP
  REFERRAL
  WALK_IN
  OTHER
}

enum ConsentCategory {
  ESSENTIAL
  ANALYTICS
  LOCATION
  MARKETING
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  UNREAD
  READ
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXPORT
  APPROVE
  REJECT
  PAY
}

enum PrivacyRequestType {
  EXPORT
  DELETE
}

enum PrivacyRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

// ============================================================================
// AUTH / RBAC / USERS
// ============================================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)

  // Granular permission profile (configurable by admin). Optional.
  roleProfile   Role?   @relation(fields: [roleProfileId], references: [id])
  roleProfileId String?

  // Account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  employee Employee?
  customer Customer?

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  loginHistory        LoginHistory[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // ADMIN, SELLER, CUSTOMER or custom
  description String?
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // e.g. "vehicle.create", "finance.read"
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success    Boolean
  ipAddress  String?
  userAgent  String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

model Employee {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String
  cpf            String    @unique
  email          String
  phone          String?
  whatsapp       String?
  position       String? // cargo
  admissionDate  DateTime?
  active         Boolean   @default(true)
  pixKey         String?
  internalNotes  String?

  // Default commission rule for this seller
  defaultCommissionRuleId String?
  defaultCommissionRule   CommissionRule? @relation(fields: [defaultCommissionRuleId], references: [id])

  sales       VehicleSale[]
  commissions Commission[]
  leads       Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("employees")
}

model Customer {
  id     String  @id @default(uuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName     String
  personType   PersonType @default(INDIVIDUAL)
  document     String     @unique // CPF or CNPJ (digits only)
  email        String?
  phone        String?
  whatsapp     String?
  birthDate    DateTime?

  // Marketing / LGPD consents (snapshot of current preference)
  marketingConsent Boolean @default(false)
  cookieConsent    Boolean @default(false)

  addresses           Address[]
  reservations        VehicleReservation[]
  sales               VehicleSale[]
  leads               Lead[]
  favorites           Favorite[]
  documents           Document[]
  cookieConsents      CookieConsent[]
  vehicleViews        VehicleView[]
  privacyRequests     PrivacyRequest[]
  marketingPreference MarketingPreference?

  anonymizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personType])
  @@index([email])
  @@map("customers")
}

model Address {
  id         String  @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label       String? // "Casa", "Trabalho"
  zipCode     String? // CEP
  street      String?
  number      String?
  complement  String?
  district    String? // bairro
  city        String?
  state       String? // UF
  isPrimary   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("addresses")
}

// ============================================================================
// STORE CONFIGURATION
// ============================================================================

model Store {
  id          String  @id @default(uuid())
  name        String
  cnpj        String?
  phone       String?
  whatsapp    String?
  email       String?

  street      String?
  number      String?
  complement  String?
  district    String?
  zipCode     String?
  city        String?
  state       String?
  latitude    Float?
  longitude   Float?

  openingHours    Json? // structured business hours
  googleMapsUrl   String?
  directionsUrl   String?
  socialLinks     Json? // { instagram, facebook, ... }
  integrations    Json? // external integration config

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stores")
}

// ============================================================================
// VEHICLES
// ============================================================================

model Vehicle {
  id           String        @id @default(uuid())
  publicCode   String        @unique // código público amigável
  slug         String        @unique
  status       VehicleStatus @default(DRAFT)

  // Identification
  brand            String
  model            String
  version          String?
  manufactureYear  Int
  modelYear        Int
  plate            String?  @unique
  renavam          String?  @unique
  chassis          String?  @unique
  engineNumber     String?
  category         String? // categoria (SUV, sedan...)
  bodyType         String? // tipo de carroceria
  color            String?
  fuel             FuelType?
  transmission     Transmission?
  doors            Int?
  mileage          Int?
  seats            Int?
  condition        VehicleCondition @default(USED)
  origin           VehicleOrigin    @default(OWN_PURCHASE)
  entryDate        DateTime         @default(now())
  archiveReason    String?

  // Commercial data (INTERNAL - never exposed publicly except announcedPrice)
  purchasePrice    Decimal? @db.Decimal(14, 2)
  suggestedPrice   Decimal? @db.Decimal(14, 2)
  announcedPrice   Decimal? @db.Decimal(14, 2)
  minPrice         Decimal? @db.Decimal(14, 2) // valor mínimo autorizado
  soldPrice        Decimal? @db.Decimal(14, 2)
  soldAt           DateTime?
  featured         Boolean  @default(false)
  availableForAd   Boolean  @default(false)
  internalNotes    String?
  publicDescription String?

  // Engagement metrics
  viewCount     Int @default(0)
  favoriteCount Int @default(0)
  contactCount  Int @default(0)

  createdById String?

  spec             VehicleSpec?
  media            VehicleMedia[]
  stockMovements   VehicleStockMovement[]
  acquisition      VehicleAcquisition?
  reservations     VehicleReservation[]
  sales            VehicleSale[]
  financialEntries FinancialEntry[]
  dre              VehicleDre?
  maintenances     Maintenance[]
  documents        Document[]
  leads            Lead[]
  favorites        Favorite[]
  views            VehicleView[]
  partMovements    PartStockMovement[]
  commissions      Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([brand])
  @@index([model])
  @@index([modelYear])
  @@index([announcedPrice])
  @@index([featured])
  @@index([availableForAd])
  @@index([viewCount])
  @@index([createdById])
  @@map("vehicles")
}

model VehicleSpec {
  id        String  @id @default(uuid())
  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  engine            String? // motorização
  power             String? // potência (cv)
  torque            String?
  displacement      String? // cilindrada
  traction          String? // tração
  steering          String? // direção
  suspension        String?
  urbanConsumption  String?
  roadConsumption   String?
  tankCapacity      String?
  trunkCapacity     String?
  length            String?
  width             String?
  height            String?
  wheelbase         String? // distância entre eixos
  weight            String?
  airbags           String?
  brakes            String?
  safetyItems       String[] @default([])
  comfortItems      String[] @default([])
  multimedia        String[] @default([])
  options           String[] @default([])
  technicalNotes    String?

  // Provenance / audit of auto-fill
  source         SpecSource @default(MANUAL)
  lastSyncedAt   DateTime?
  fieldSources   Json? // map of field -> source for manual override auditing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_specs")
}

model VehicleMedia {
  id        String  @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type        String  @default("image") // image | video
  url         String
  storageKey  String?
  isMain      Boolean @default(false)
  position    Int     @default(0)
  altText     String?
  published   Boolean @default(true)
  uploadedById String?

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([position])
  @@map("vehicle_media")
}

model VehicleStockMovement {
  id        String            @id @default(uuid())
  vehicleId String
  vehicle   Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      StockMovementType
  fromStatus VehicleStatus?
  toStatus   VehicleStatus?
  reason     String?
  notes      String?
  performedById String?

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([type])
  @@index([createdAt])
  @@map("vehicle_stock_movements")
}

model VehicleAcquisition {
  id        String  @id @default(uuid())
  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type            AcquisitionType   @default(OWN_PURCHASE)
  sellerName      String? // quem vendeu o veículo para a loja
  sellerDocument  String? // CPF/CNPJ
  purchasePrice   Decimal           @db.Decimal(14, 2)
  purchaseDate    DateTime
  paymentMethod   PaymentMethod?
  installments    Int?
  additionalCosts Decimal?          @db.Decimal(14, 2)
  responsibleId   String?
  notes           String?
  status          AcquisitionStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_acquisitions")
}

model VehicleReservation {
  id        String  @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  sellerId      String? // Employee id
  reservedAt    DateTime @default(now())
  expiresAt     DateTime
  depositAmount Decimal? @db.Decimal(14, 2)
  paymentMethod PaymentMethod?
  status        ReservationStatus @default(ACTIVE)
  cancelReason  String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([expiresAt])
  @@map("vehicle_reservations")
}

model VehicleSale {
  id        String  @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  sellerId   String
  seller     Employee @relation(fields: [sellerId], references: [id])

  saleDate        DateTime?
  announcedPrice  Decimal?  @db.Decimal(14, 2)
  negotiatedPrice Decimal?  @db.Decimal(14, 2)
  discount        Decimal?  @db.Decimal(14, 2)
  finalPrice      Decimal?  @db.Decimal(14, 2)
  paymentMethod   PaymentMethod?
  downPayment     Decimal?  @db.Decimal(14, 2)
  installments    Int?
  financing       Boolean   @default(false)
  financialInstitution String?
  tradeInVehicleId     String? // veículo recebido como troca (optional)
  deliveryForecast     DateTime?
  deliveredAt          DateTime?
  notes                String?
  status               SaleStatus @default(NEGOTIATING)

  commission Commission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([saleDate])
  @@map("vehicle_sales")
}

// ============================================================================
// FINANCIAL / DRE
// ============================================================================

model FinancialEntry {
  id        String  @id @default(uuid())
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  nature        FinancialNature
  category      String // see BUSINESS_RULES.md for canonical categories
  description   String?
  amount        Decimal         @db.Decimal(14, 2)
  date          DateTime        @default(now())
  origin        FinancialOrigin @default(MANUAL)
  sourceModule  String? // "maintenance", "parts", "acquisition", "sale", "commission"
  externalRef   String? // id of source record
  documentId    String?
  responsibleId String?
  notes         String?
  status        FinancialStatus @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([nature])
  @@index([category])
  @@index([date])
  @@index([sourceModule])
  @@map("financial_entries")
}

// Cached/aggregated DRE per vehicle (recomputed on financial changes).
model VehicleDre {
  id        String  @id @default(uuid())
  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  totalInvested   Decimal @default(0) @db.Decimal(14, 2)
  totalExpenses   Decimal @default(0) @db.Decimal(14, 2)
  totalRevenue    Decimal @default(0) @db.Decimal(14, 2)
  grossProfit     Decimal @default(0) @db.Decimal(14, 2)
  commissionTotal Decimal @default(0) @db.Decimal(14, 2)
  netProfit       Decimal @default(0) @db.Decimal(14, 2)
  profitMargin    Float   @default(0) // percentage
  daysInStock     Int     @default(0)
  costPerDay      Decimal @default(0) @db.Decimal(14, 2)
  discountGiven   Decimal @default(0) @db.Decimal(14, 2)

  categoryBreakdown Json? // { category: total }
  lastCalculatedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_dre")
}

// ============================================================================
// COMMISSIONS
// ============================================================================

model CommissionRule {
  id          String             @id @default(uuid())
  name        String
  type        CommissionRuleType
  percentage  Decimal?           @db.Decimal(7, 4) // for percent-based rules
  fixedAmount Decimal?           @db.Decimal(14, 2) // for fixed rules
  tiers       Json? // for progressive rules: [{ min, max, percentage }]
  isDefault   Boolean            @default(false)
  active      Boolean            @default(true)
  description String?

  employees   Employee[]
  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
  @@map("commission_rules")
}

model Commission {
  id       String @id @default(uuid())
  sellerId String
  seller   Employee @relation(fields: [sellerId], references: [id])

  saleId    String      @unique
  sale      VehicleSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   Vehicle?    @relation(fields: [vehicleId], references: [id])

  ruleId       String?
  rule         CommissionRule? @relation(fields: [ruleId], references: [id])
  calcBase     Decimal         @db.Decimal(14, 2) // base de cálculo
  percentage   Decimal?        @db.Decimal(7, 4)
  amount       Decimal         @db.Decimal(14, 2)
  status       CommissionStatus @default(PENDING)
  generatedAt  DateTime         @default(now())
  approvedAt   DateTime?
  paidAt       DateTime?
  approvedById String?
  notes        String?
  manualAdjustment Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
  @@index([generatedAt])
  @@map("commissions")
}

// ============================================================================
// PARTS INVENTORY
// ============================================================================

model Supplier {
  id       String  @id @default(uuid())
  name     String
  document String? // CPF/CNPJ
  email    String?
  phone    String?
  whatsapp String?
  notes    String?
  active   Boolean @default(true)

  parts        Part[]
  maintenances Maintenance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

model Part {
  id           String     @id @default(uuid())
  internalCode String     @unique
  sku          String?    @unique
  barcode      String?
  name         String
  category     String?
  brand        String?
  compatibleModel String? // modelo compatível
  description  String?
  quantity     Int        @default(0)
  minQuantity  Int        @default(0)
  unit         String     @default("UN") // unidade de medida
  costPrice    Decimal    @default(0) @db.Decimal(14, 2)
  averagePrice Decimal    @default(0) @db.Decimal(14, 2)
  location     String? // localização no estoque
  supplierId   String?
  supplier     Supplier?  @relation(fields: [supplierId], references: [id])
  entryDate    DateTime   @default(now())
  status       PartStatus @default(ACTIVE)
  notes        String?

  movements      PartStockMovement[]
  maintenanceUse MaintenancePart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([quantity])
  @@map("parts")
}

model PartStockMovement {
  id     String           @id @default(uuid())
  partId String
  part   Part             @relation(fields: [partId], references: [id], onDelete: Cascade)
  type   PartMovementType
  quantity Int
  unitCost Decimal?       @db.Decimal(14, 2)
  totalCost Decimal?      @db.Decimal(14, 2)

  // Optional links when used in a maintenance / applied to a vehicle
  vehicleId     String?
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  maintenanceId String?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  reason        String?
  notes         String?
  performedById String?
  reversedById  String? // points to the movement that reverses this one

  createdAt DateTime @default(now())

  @@index([partId])
  @@index([type])
  @@index([vehicleId])
  @@index([maintenanceId])
  @@map("part_stock_movements")
}

// ============================================================================
// MAINTENANCE
// ============================================================================

model Maintenance {
  id        String  @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type          MaintenanceType   @default(CORRECTIVE)
  description   String?
  workshop      String? // oficina
  supplierId    String?
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  openedAt      DateTime          @default(now())
  forecastDate  DateTime?
  completedAt   DateTime?
  mileage       Int?
  responsibleId String?
  laborCost     Decimal           @default(0) @db.Decimal(14, 2)
  partsCost     Decimal           @default(0) @db.Decimal(14, 2)
  totalCost     Decimal           @default(0) @db.Decimal(14, 2)
  invoiceNumber String? // nota fiscal
  warranty      String?
  nextRevisionDate     DateTime?
  nextRevisionMileage  Int?
  status        MaintenanceStatus @default(SCHEDULED)
  notes         String?

  parts             MaintenancePart[]
  partStockMoves    PartStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([forecastDate])
  @@index([nextRevisionDate])
  @@map("maintenances")
}

model MaintenancePart {
  id            String      @id @default(uuid())
  maintenanceId String
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  partId        String
  part          Part        @relation(fields: [partId], references: [id])
  quantity      Int
  unitCost      Decimal     @db.Decimal(14, 2)
  totalCost     Decimal     @db.Decimal(14, 2)
  reversed      Boolean     @default(false)

  createdAt DateTime @default(now())

  @@index([maintenanceId])
  @@index([partId])
  @@map("maintenance_parts")
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model DocumentType {
  id          String            @id @default(uuid())
  code        String            @unique // e.g. "CRLV", "RG"
  name        String
  ownerType   DocumentOwnerType
  description String?
  active      Boolean           @default(true)
  hasExpiry   Boolean           @default(false)

  documents      Document[]
  checklistItems DocumentChecklist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerType])
  @@map("document_types")
}

// Configurable per-stage checklist template.
model DocumentChecklist {
  id             String         @id @default(uuid())
  stage          ChecklistStage
  documentTypeId String
  documentType   DocumentType   @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  required       Boolean        @default(true)
  position       Int            @default(0)
  active         Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stage, documentTypeId])
  @@index([stage])
  @@map("document_checklists")
}

model Document {
  id             String         @id @default(uuid())
  documentTypeId String
  documentType   DocumentType   @relation(fields: [documentTypeId], references: [id])
  ownerType      DocumentOwnerType

  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  saleId     String?

  fileUrl        String?
  storageKey     String?
  originalName   String?
  mimeType       String?
  size           Int?
  issueDate      DateTime?
  expiryDate     DateTime?
  status         DocumentStatus @default(NOT_REQUESTED)
  responsibleId  String?
  uploadedAt     DateTime?
  validatedAt    DateTime?
  validatedById  String?
  notes          String?
  rejectionReason String?

  versions DocumentVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([customerId])
  @@index([saleId])
  @@index([status])
  @@index([expiryDate])
  @@index([ownerType])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  fileUrl      String?
  storageKey   String?
  originalName String?
  mimeType     String?
  size         Int?
  uploadedById String?

  createdAt DateTime @default(now())

  @@index([documentId])
  @@map("document_versions")
}

// ============================================================================
// LEADS
// ============================================================================

model Lead {
  id String @id @default(uuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name       String?
  phone      String?
  email      String?

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  origin       LeadOrigin @default(SPECIALIST_BUTTON)
  sourcePage   String?
  assignedSellerId String?
  assignedSeller   Employee? @relation(fields: [assignedSellerId], references: [id], onDelete: SetNull)
  initialMessage   String?
  whatsappUrl      String?
  status           LeadStatus @default(NEW)

  firstContactAt DateTime?
  convertedAt    DateTime?
  notes          String?

  interactions LeadInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedSellerId])
  @@index([status])
  @@index([vehicleId])
  @@index([createdAt])
  @@map("leads")
}

model LeadInteraction {
  id        String  @id @default(uuid())
  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // "note", "call", "whatsapp", "status_change"
  content   String?
  authorId  String?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_interactions")
}

// ============================================================================
// TRACKING / LGPD / MARKETING
// ============================================================================

model Favorite {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, vehicleId])
  @@index([customerId])
  @@index([vehicleId])
  @@map("favorites")
}

model VehicleView {
  id         String    @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId  String? // anonymous visitor session
  ipHash     String? // hashed IP (privacy-safe)
  userAgent  String?
  sourcePage String?

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([customerId])
  @@index([createdAt])
  @@map("vehicle_views")
}

model CookieConsent {
  id         String          @id @default(uuid())
  customerId String?
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId  String?
  category   ConsentCategory
  granted    Boolean
  termsVersion String?
  ipHash     String?
  userAgent  String?
  latitude   Float? // only when LOCATION consent granted
  longitude  Float?

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([sessionId])
  @@index([category])
  @@map("cookie_consents")
}

model MarketingPreference {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  emailOptIn      Boolean  @default(false)
  whatsappOptIn   Boolean  @default(false)
  interestBrands  String[] @default([])
  interestModels  String[] @default([])
  priceMin        Decimal? @db.Decimal(14, 2)
  priceMax        Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("marketing_preferences")
}

model PrivacyRequest {
  id         String               @id @default(uuid())
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       PrivacyRequestType
  status     PrivacyRequestStatus @default(PENDING)
  payload    Json? // exported data snapshot for EXPORT
  processedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("privacy_requests")
}

// ============================================================================
// NOTIFICATIONS / EMAIL
// ============================================================================

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @default(IN_APP)
  type      String // e.g. "document.pending", "commission.approved"
  title     String
  body      String?
  data      Json?
  status    NotificationStatus  @default(UNREAD)
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("notifications")
}

model EmailQueue {
  id          String      @id @default(uuid())
  to          String
  subject     String
  template    String
  context     Json?
  status      EmailStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("email_queue")
}

// ============================================================================
// AUDIT
// ============================================================================

model AuditLog {
  id          String      @id @default(uuid())
  actorId     String?
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      AuditAction
  entity      String // "Vehicle", "Sale", ...
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  source      String? // "api", "job", "seed"
  reason      String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
